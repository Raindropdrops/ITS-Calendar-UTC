{
  "manifest_version": 3,
  "name": "ITS Calendar — Lịch học UTC",
  "short_name": "ITS Calendar",
  "description": "Quét lịch học và lịch thi từ QLĐT UTC rồi xuất sang Google Calendar. Dự án cộng đồng bởi Đức Anh — ITS K65.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/Raindropdrops/ITS-Calendar-UTC",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://qldt.utc.edu.vn/*"],
  "action": {
    "default_title": "ITS Calendar — Xuất lịch QLĐT UTC",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://qldt.utc.edu.vn/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://qldt.utc.edu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
