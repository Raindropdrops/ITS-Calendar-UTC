{
  "manifest_version": 3,
  "name": "UTC Calendar Exporter",
  "description": "Quét lịch học và lịch thi từ QLĐT UTC rồi xuất sang Google Calendar.",
  "version": "0.2.0",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://qldt.utc.edu.vn/*"],
  "action": {
    "default_title": "Xuất lịch QLĐT UTC",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://qldt.utc.edu.vn/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://qldt.utc.edu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
